rules_version = '2';

// Firestore security rules for Sitevento.
//
// ── Design ────────────────────────────────────────────────────────────
// Every write that matters for security (visit tracking, widget
// delivery, overlay stats, verifying a site) is already performed
// server-side through the Firebase Admin SDK (app/api/*/route.ts),
// which BYPASSES these rules entirely. These rules exist to govern what
// the Firebase client SDK (firebase, not firebase-admin — used in
// hooks/*.ts, running in the owner's own browser) is allowed to do
// directly, and to act as defense-in-depth if a client path is ever
// added later.
//
// Nothing in here grants a third-party site visitor (who has no
// sitevento account) any read or write access — all visitor-facing
// data flow goes through the Admin-SDK-backed API routes instead.
//
// siteOverlay/{siteId} is the one deliberate exception: it must be
// PUBLICLY READABLE, because the embedded sitevento.js snippet running
// on a visitor's browser reads it directly via the client SDK (no
// backend hop, so the banner can update with zero added latency/cost).
// It is written only by app/api/user-action's 'save-overlay' action
// (Admin SDK) — not by the client SDK at all, by anyone, owner included.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- users/{uid} and everything under it ----
    // Default: a signed-in user may read/write only their own subtree.
    // This still covers full read/write on .../leads/{id} and
    // .../widgets/{widgetId} (per-site widget permission/config), which
    // have no more specific override below. Every other path under
    // users/{uid} — the profile doc itself, sites/{siteId}, its visits
    // and blockedVisitors subcollections, and usage/{day} — now has a
    // more specific `match` block below that narrows or fully replaces
    // this default, because those writes go through an Admin-SDK route
    // instead.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ---- users/{uid} (the profile doc itself): block client-side WRITE ----
    // More specific than the users/{uid}/{document=**} default above.
    // `displayName`, `settings`, and `plan` all now go through
    // app/api/user-action/route.ts ('update-profile', 'update-settings',
    // 'update-plan' — see doUpdateProfile/doUpdateSettings/doUpdatePlan),
    // and the doc's initial creation happens in app/api/create-account
    // (Admin SDK) at signup. Nothing on this doc is client-writable
    // anymore; read stays client-side for the dashboard's own profile/
    // settings/plan display.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // ---- users/{uid}/sites/{siteId}: block client-side CREATE/UPDATE/DELETE ----
    // More specific than the users/{uid}/{document=**} match above, so
    // this one wins for exactly this path. Every write that used to
    // happen here client-side now goes through an Admin-SDK route:
    // `create` via app/api/connect-site (atomically enforces the plan's
    // connectedSites limit — not doable race-safe purely in rules),
    // `update` via app/api/user-action ('pause-site' for `paused`,
    // 'save-overlay' for `overlay` — see that route's doPauseSite/
    // doSaveOverlay), and `delete` via app/api/user-action
    // ('disconnect-site' — see doDisconnectSite, which also cleans up
    // the matching siteIndex/{siteId} doc in the same request, something
    // a client-side delete here could never do atomically). Read stays
    // client-side — the dashboard's live site-list subscription
    // (hooks/useSites.ts) still reads this collection directly.
    match /users/{uid}/sites/{siteId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    // ---- users/{uid}/sites/{siteId}/visits/{visitId}: block client
    // writes to `blocked` and `restrictedUntil` ----
    // Flipping `blocked` goes through app/api/block-visitor/route.ts
    // (Admin SDK) so the daily visitor-blocking quota (lib/limits.ts's
    // FEATURE_LIMITS['visitor-access-control']) can be enforced
    // atomically against the write. `restrictedUntil` now goes through
    // app/api/user-action's 'restrict-visitor' action (see
    // doRestrictVisitor) instead of hooks/useActiveSiteData.ts's old
    // client-side writeBatch, so it counts against the account's daily
    // write limit the same as every other action — a client-only check
    // is bypassable by calling the Firestore client SDK directly. This
    // rule only blocks a client write that touches either field, not
    // the whole document.
    match /users/{uid}/sites/{siteId}/visits/{visitId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, delete: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['blocked', 'restrictedUntil']);
    }

    // ---- users/{uid}/sites/{siteId}/blockedVisitors/{visitorId}:
    // block client-side CREATE/writing `blockedAt` or `restrictedUntil` ----
    // The permanent-block doc itself is created/deleted only by
    // app/api/block-visitor/route.ts. restrictVisitor's timed
    // `restrictedUntil` field on this same doc now also goes
    // server-side (app/api/user-action's 'restrict-visitor' action —
    // see doRestrictVisitor), so this rule blocks both fields along
    // with create/delete (the permanent-block lifecycle) — nothing on
    // this doc is client-writable anymore.
    match /users/{uid}/sites/{siteId}/blockedVisitors/{visitorId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, delete: if false;
      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['blockedAt', 'restrictedUntil']);
    }

    // ---- users/{uid}/usage/{day}: daily quota counters, server-only ----
    // Written exclusively by lib/usageTracking.ts / the Admin-SDK
    // routes that call it (e.g. app/api/block-visitor). A client that
    // could write its own usage counters could simply reset them to
    // dodge the daily trial/quota limits entirely, so this is
    // deliberately NOT covered by the users/{uid} default above —
    // no client read or write at all.
    match /users/{uid}/usage/{day} {
      allow read, write: if false;
    }

    // ---- siteIndex/{siteId} ----
    // Flat siteId -> uid lookup, written once when a site is connected
    // (hooks/useConnectSiteWizard.ts) and read by every Admin-SDK
    // route to resolve ownership. siteId is not a secret (it's in the
    // public install tag), but the uid it maps to should not be
    // discoverable/writable by anyone other than its owner via the
    // client SDK. The Admin SDK bypasses this rule anyway for the
    // server-side reads in app/api/*.
    // `create` moved server-side too (see users/{uid}/sites/{siteId}'s
    // comment above) — app/api/connect-site/route.ts writes this doc
    // in the same Admin-SDK transaction as the site doc it indexes, so
    // the two can never be created out of sync via two separate client
    // calls. Read/update/delete stay as they were.
    match /siteIndex/{siteId} {
      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow create: if false;
      allow update, delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // ---- siteOverlay/{siteId} ----
    // Public read (see note above) so the live-banner listener in
    // public/sitevento.js works with no backend hop. Write is
    // intentionally NOT exposed to the client SDK at all right now —
    // the dashboard's BannerComposer writes the owner's
    // users/{uid}/sites/{siteId}.overlay field (covered by the
    // users/{uid} rule above); nothing in this codebase currently
    // writes directly to a top-level siteOverlay/{siteId} doc from the
    // client, so this stays read-only here until that changes.
    match /siteOverlay/{siteId} {
      allow read: if true;
      allow write: if false;
    }

    // ---- widgets/{widgetId} (global catalog) ----
    // Managed exclusively via the Firebase Admin SDK (a trusted
    // internal script/admin tool — see "Adding a widget" in the
    // deployment guide), never from the browser. Not even publicly
    // readable: the catalog's existence/contents are an implementation
    // detail, not something a site visitor's browser needs to read
    // directly — app/api/widget/route.ts (Admin SDK) is the only
    // reader, and it returns only the one requested widget's
    // public-safe fields in its response.
    match /widgets/{widgetId} {
      allow read, write: if false;

      match /usage/{day} {
        allow read, write: if false;
      }
    }

    // Default deny for anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
